# The environment variables the code reads. Copy this file to .env, which git ignores, and fill in the values.

# Who to contact about the requests the code sends to IIIF servers: an e-mail address or a project's name. Sent in
# the User-Agent header.
LVC_CONTACT=

# A Hugging Face token (a Read token) of an account granted access to DINOv3's gated repository,
# facebook/dinov3-vits16-pretrain-lvd1689m, for `make -C reproduce table-vit-backbones` alone.
HF_TOKEN=
